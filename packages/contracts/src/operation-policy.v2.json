      "failure_patterns": [
        {
          "code": "NO_TARGETS",
          "patterns": [
            "\\bno (?:players?|entities|targets?) (?:was |were )?found\\b",
            "\\bno (?:players?|entities|targets?) match(?:ed|es)?\\b",
            "\\bselector .{0,80} found no (?:players?|entities|targets?)\\b",
            "(?:未找到|没有找到|找不到|无匹配的)(?:任何)?(?:玩家|实体|目标)"
          ],
          "user_message": "没有找到符合条件的目标，因此没有对象收到或应用这次操作。"
        },
        {
          "code": "INVALID_COMMAND",
          "patterns": [
            "\\bunknown or incomplete command\\b",
            "\\bunknown command\\b",
            "\\bincorrect argument\\b",
            "\\binvalid (?:command|argument|syntax)\\b",
            "\\bsyntax error\\b",
            "(?:未知命令|命令不完整|命令语法错误|参数错误|无效命令)"
          ],
          "user_message": "服务器拒绝了这条命令，因为命令或参数无效。"
        },
        {
          "code": "PERMISSION_DENIED",
          "patterns": [
            "\\byou do not have permission\\b",
            "\\bnot permitted\\b",
            "\\bpermission denied\\b",
            "\\binsufficient permissions?\\b",
            "(?:没有权限|权限不足|不允许执行)"
          ],
          "user_message": "服务器拒绝了这条命令，因为当前执行身份没有足够权限。"
        },
        {
          "code": "EXECUTION_ERROR",
          "patterns": [
            "\\ban unexpected error occurred trying to execute\\b",
            "\\bexception (?:while|when) executing\\b",
            "\\bcould not execute\\b",
            "\\bfailed to execute\\b",
            "\\bcommand failed\\b",
            "(?:执行命令时发生错误|命令执行失败|无法执行命令)"
          ],
          "user_message": "服务器在执行命令时返回错误，这次操作没有成功应用。"
        }
      ],
      "success_patterns": [
        "\\b(?:successfully|broadcasted|announced|message sent)\\b",
        "\\bdisplayed (?:message|title|text) to [1-9][0-9]* (?:players?|entities|targets?)\\b",
